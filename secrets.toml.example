# Template for Streamlit Secrets.
# - Community Cloud: paste the real values into App settings -> Secrets
# - Local run: copy this file to .streamlit/secrets.toml (git-ignored)
#
# Passwords must be bcrypt hashes. Create one with:  python generate_password.py

[cookie]
name = "freight_platform_cookie"
key = "replace-with-a-long-random-string"
expiry_days = 30

[credentials.usernames.ashita]
name = "Ashita Serrao"
password = "$2b$12$...hash..."

[credentials.usernames.another_user]
name = "Another User"
password = "$2b$12$...hash..."


# Lets the ashita account publish new tariffs from the app. They're kept in one file in
# Ashita's Google Drive (not in GitHub) and loaded back whenever the app restarts.
# file_id: the id in the shared file's link, https://drive.google.com/file/d/<file_id>/view
[drive]
file_id = "..."

# The Google service account's JSON key (Google Cloud -> IAM & Admin -> Service Accounts -> Keys)
[gcp_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "...@....iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"
