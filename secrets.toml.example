# Template for Streamlit Secrets.
# - Community Cloud: paste the real values into App settings -> Secrets
# - Local run: copy this file to .streamlit/secrets.toml (git-ignored)
#
# Passwords must be bcrypt hashes. Create one with:  python generate_password.py

[cookie]
name = "freight_platform_cookie"
key = "replace-with-a-long-random-string"
expiry_days = 30

[credentials.usernames.ashita]
name = "Ashita Serrao"
password = "$2b$12$...hash..."

[credentials.usernames.another_user]
name = "Another User"
password = "$2b$12$...hash..."


# Lets the ashita account publish new tariffs from the app (saved to this repo on GitHub).
# token: GitHub -> Settings -> Developer settings -> Fine-grained tokens -> Generate new token,
#        Repository access: Only select repositories -> TestingAcl,
#        Permissions -> Contents: Read and write.
[github]
token = "github_pat_..."
repo = "ashitaserrao3/TestingAcl"
branch = "main"
