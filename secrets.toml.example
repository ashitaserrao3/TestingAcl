# Template for Streamlit Secrets.
# - Community Cloud: paste the real values into App settings -> Secrets
# - Local run: copy this file to .streamlit/secrets.toml (git-ignored)
#
# Passwords must be bcrypt hashes. Create one with:  python generate_password.py

[cookie]
name = "freight_platform_cookie"
key = "replace-with-a-long-random-string"
expiry_days = 30

[credentials.usernames.ashita]
name = "Ashita Serrao"
password = "$2b$12$...hash..."

[credentials.usernames.another_user]
name = "Another User"
password = "$2b$12$...hash..."

# ---------------- Activity log (optional) ----------------
# Google Sheet that records logins, failed logins, logouts, time spent and activity.
# Leave these two sections out and the app simply runs without logging.

[activity_log]
sheet_id = "the-long-id-in-the-sheet-url-between-/d/-and-/edit"

[gcp_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "acl-logger@your-project.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"
